#include <stdio.h>
#include <string.h>

int main() {
    char data[50], gen[50], temp[100], sent[100], received[100];
    int data_len, gen_len, i, j;

    printf("Enter data bits: ");
    scanf("%s", data);
    printf("Enter generator bits: ");
    scanf("%s", gen);

    data_len = strlen(data);
    gen_len = strlen(gen);

    strcpy(temp, data);
    for (i = 0; i < gen_len - 1; i++) {
        temp[data_len + i] = '0';
    }
    temp[data_len + i] = '\0';

    for (i = 0; i < data_len; i++) {
        if (temp[i] == '1') {
            for (j = 0; j < gen_len; j++) {
                temp[i + j] = (temp[i + j] == gen[j]) ? '0' : '1';
            }
        }
    }

    strcpy(sent, data);
    strcat(sent, &temp[data_len]);

    printf("\nCRC Remainder (Checksum): %s", &temp[data_len]);
    printf("\nTransmitted Codeword: %s\n", sent);

    printf("\nEnter received codeword: ");
    scanf("%s", received);

    if (strcmp(sent, received) == 0) {
        printf("Result: 0 (No Error! Received data matches sent data)\n");
    } else {
        printf("Result: Incorrect code! Error detected in received data.\n");
    }

    return 0;
}
